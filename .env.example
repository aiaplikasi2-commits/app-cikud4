# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet/backend is hosted.
APP_URL="MY_APP_URL"

# VITE_API_BASE_URL: (Opsional untuk Netlify build) URL lengkap server backend Node/Express
# jika frontend di-host terpisah dari server.ts (contoh: https://backend-anda.run.app).
# Kosongkan jika memakai proxy same-origin BACKEND_URL di Netlify atau berjalan di server yang sama.
VITE_API_BASE_URL=""

# BACKEND_URL: (Untuk Netlify Function proxy /api/* & /uploads/*)
# URL server backend Express (server.ts) agar permintaan /api/* di domain Netlify otomatis diteruskan ke backend.
BACKEND_URL=""

# ALLOWED_ORIGINS: (Untuk server.ts) Daftar domain frontend yang diizinkan oleh CORS, dipisahkan koma.
# Contoh: https://sdnciketingudik4.netlify.app,https://domain-sekolah.sch.id
ALLOWED_ORIGINS=""

# SESSION_SECRET: (Opsional untuk produksi backend) Minimal 32 karakter acak untuk menandatangani token sesi.
SESSION_SECRET=""
